{
  "manifestVersion": 5,
  "id": "arttrace.photoshop",
  "name": "Arttrace",
  "version": "0.9.0",
  "main": "index.html",
  "icons": [
    {
      "width": 48,
      "height": 48,
      "path": "icons/icon-48.png"
    },
    {
      "width": 96,
      "height": 96,
      "path": "icons/icon-96.png"
    },
    {
      "width": 192,
      "height": 192,
      "path": "icons/icon-192.png"
    }
  ],
  "host": [
    {
      "app": "PS",
      "minVersion": "25.0.0"
    }
  ],
  "type": "panel",
  "entrypoints": [
    {
      "type": "panel",
      "id": "mainPanel",
      "label": {
        "default": "Arttrace"
      },
      "minimumSize": {
        "width": 300,
        "height": 450
      },
      "maximumSize": {
        "width": 600,
        "height": 900
      },
      "preferredDockedSize": {
        "width": 340,
        "height": 550
      }
    }
  ],
  "permissions": {
    "allowCodeGenerationFromStrings": true,
    "localFileSystem": "fullAccess",
    "launchProcess": {
      "schemes": [
        "https"
      ],
      "extensions": [
        "",
        ".png",
        ".jpg",
        ".json"
      ]
    },
    "enableAlerts": true
  }
}
